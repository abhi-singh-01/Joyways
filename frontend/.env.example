# Public backend API URL (safe to expose to the browser)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Razorpay publishable key only — never put RAZORPAY_KEY_SECRET here
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Public contact addresses only — never put SMTP credentials here
NEXT_PUBLIC_SUPPORT_EMAIL=support@joyway.in
NEXT_PUBLIC_BOOKINGS_EMAIL=bookings@joyway.in
NEXT_PUBLIC_GENERAL_EMAIL=hello@joyway.in

# Public phone numbers (E.164 without +), e.g. 919696313547
NEXT_PUBLIC_CALL_NUMBER=919696313547
NEXT_PUBLIC_WHATSAPP_NUMBER=917050971956
