# JOYWAY Backend — Production environment template
# Copy to Azure App Service / Container Apps configuration. NEVER commit real values.

SPRING_PROFILES_ACTIVE=prod

# Azure PostgreSQL
DATABASE_URL=jdbc:postgresql://YOUR-SERVER.postgres.database.azure.com:5432/joyway?sslmode=require
DATABASE_USERNAME=
DATABASE_PASSWORD=

SERVER_PORT=8080

JWT_SECRET=
JWT_EXPIRATION_MS=3600000
JWT_COOKIE_SECURE=true

CORS_ALLOWED_ORIGINS=https://joyway.in,https://www.joyway.in
PUBLIC_API_BASE_URL=https://api.joyway.in
FRONTEND_BASE_URL=https://joyway.in

ADMIN_BOOTSTRAP_ENABLED=false

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SSL=true
SMTP_STARTTLS=false
SMTP_USERNAME=hello@joyway.in
SMTP_PASSWORD=

MAIL_FROM=hello@joyway.in
MAIL_BOOKINGS_FROM=bookings@joyway.in
MAIL_SUPPORT_FROM=support@joyway.in
MAIL_NOREPLY_FROM=noreply@joyway.in
MAIL_ENABLED=true
MAIL_PREVIEW_ENABLED=false
ADMIN_NOTIFICATION_EMAIL=hello@joyway.in

EXPOSE_DRIVER_CONTACT_TO_CUSTOMERS=false
TRIP_REMINDER_ENABLED=true

# Azure Blob Storage (required in production)
STORAGE_PROVIDER=azure
STORAGE_ENDPOINT=https://YOUR-STORAGE-ACCOUNT.blob.core.windows.net
STORAGE_CONTAINER=joyway-documents
STORAGE_BUCKET=joyway-documents
STORAGE_USE_MANAGED_IDENTITY=true
STORAGE_SAS_EXPIRY_MINUTES=15
STORAGE_LOCAL_PATH=/app/storage
