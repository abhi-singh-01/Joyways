# JOYWAY Backend — Development environment template
# Copy to backend/.env and fill in values. NEVER commit backend/.env.

SPRING_PROFILES_ACTIVE=dev

# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/joyway
DATABASE_USERNAME=joyway
DATABASE_PASSWORD=

SERVER_PORT=8080

JWT_SECRET=change-me-use-a-long-random-secret-in-real-environments
JWT_EXPIRATION_MS=3600000
JWT_COOKIE_SECURE=false

CORS_ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_API_BASE_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:3000

ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_BOOTSTRAP_EMAIL=admin@joyway.in
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=JOYWAY Admin

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SSL=false
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=hello@joyway.in
MAIL_ENABLED=true
MAIL_PREVIEW_ENABLED=false

# Document storage — local filesystem for development
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=joyway-documents
STORAGE_CONTAINER=joyway-documents
STORAGE_USE_MANAGED_IDENTITY=false
STORAGE_SAS_EXPIRY_MINUTES=15
