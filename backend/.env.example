# Copy to .env for local development only. Never commit .env or .env.production.
# Production secrets are injected at runtime by Render (not in Git or Docker images).

SPRING_PROFILES_ACTIVE=dev

# Database
# Production: use your Supabase/Neon/Render Postgres connection string
DATABASE_URL=jdbc:postgresql://localhost:5432/joyway
DATABASE_USERNAME=joyway
DATABASE_PASSWORD=

# Auth
JWT_SECRET=
JWT_EXPIRATION_MS=3600000
JWT_COOKIE_SECURE=false
JWT_COOKIE_DOMAIN=

# URLs
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Production should include both apex and www: https://joyway.in,https://www.joyway.in
PUBLIC_API_BASE_URL=http://localhost:8080
# Optional CDN/R2 public URL for package images. Leave empty to serve via backend proxy.
PACKAGE_IMAGE_CDN_BASE_URL=
FRONTEND_BASE_URL=http://localhost:3000
# E.164 without + — used in confirmation emails for WhatsApp deep links
PUBLIC_WHATSAPP_NUMBER=917050971956

# Admin bootstrap (local first admin only — must be false in production)
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_EMAIL=admin@joyway.in
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=JOYWAY Admin

# Razorpay (server-side secrets — never in frontend)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SSL=false
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_ENABLED=true
MAIL_PREVIEW_ENABLED=false

# Storage (use local for dev, s3 for Cloudflare R2 / Backblaze B2 in production)
STORAGE_PROVIDER=local
# S3-compatible endpoint, e.g. https://<account-id>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=
STORAGE_CONTAINER=joyway-documents
STORAGE_BUCKET=joyway-documents
STORAGE_LOCAL_PATH=./storage
# S3 credentials (used when STORAGE_PROVIDER=s3)
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# S3 region — default is "auto" (Cloudflare R2). Set to your region for Backblaze B2, e.g. us-west-004
STORAGE_S3_REGION=auto
# Optional: public base URL for public R2 bucket, e.g. https://pub-abc123.r2.dev
# When set, file URLs are permanent public URLs instead of presigned URLs.
STORAGE_PUBLIC_BASE_URL=
# Azure-only settings (leave blank when using S3-compatible storage)
STORAGE_USE_MANAGED_IDENTITY=false

# Operations
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=memory
# Production with Redis (optional — memory works fine on Render free tier):
# RATE_LIMIT_BACKEND=redis
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_SSL=true
BOOKING_PAYMENT_WINDOW_MINUTES=30
BOOKING_PAYMENT_REMINDER_MINUTES=10
