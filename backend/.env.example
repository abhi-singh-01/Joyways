# Copy to .env for local development only. Never commit .env or .env.production.
# Production secrets are injected at runtime by Azure Container Apps (not in Git or Docker images).

SPRING_PROFILES_ACTIVE=dev

# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/joyway
DATABASE_USERNAME=joyway
DATABASE_PASSWORD=

# Auth
JWT_SECRET=
JWT_EXPIRATION_MS=3600000
JWT_COOKIE_SECURE=false
JWT_COOKIE_DOMAIN=

# URLs
CORS_ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_API_BASE_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:3000

# Admin bootstrap (local first admin only — must be false in production)
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_EMAIL=admin@joyway.in
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=JOYWAY Admin

# Razorpay (server-side secrets — never in frontend)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SSL=false
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_ENABLED=true
MAIL_PREVIEW_ENABLED=false

# Storage (use local for dev, azure for production)
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=
STORAGE_CONTAINER=joyway-documents
STORAGE_BUCKET=joyway-documents
STORAGE_LOCAL_PATH=./storage
STORAGE_USE_MANAGED_IDENTITY=false
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Operations
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=memory
# Production (Azure Managed Redis OSSCluster — requires cluster-aware Lettuce client):
# RATE_LIMIT_BACKEND=redis
# REDIS_HOST=joyway-redis-prod.centralindia.redis.azure.net
# REDIS_PORT=10000
# REDIS_PASSWORD=
# REDIS_SSL=true
# RATE_LIMIT_LOGIN_FAIL_CLOSED=true
# REDIS_COMMAND_TIMEOUT_MS=1000
BOOKING_PAYMENT_WINDOW_MINUTES=30
