# Dependencies
node_modules/
frontend/node_modules/
backend/target/

# Environment secrets — never commit, never push to GitHub
# Keep only *.example / *.template files in the repo (placeholders, no real values).
.env
.env.*
.envrc
.env.vault
*.env
*.env.local
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
!.env.example
!.env.template
!.env.production.example
!backend/.env.example
!backend/.env.template
!backend/.env.production.example
!frontend/.env.example
!frontend/.env.template
!frontend/.env.production.example

